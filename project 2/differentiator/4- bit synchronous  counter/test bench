`timescale 1ns/1ps

module tb_sync_counter;

reg clk;
reg reset;
wire [3:0] count;

// Instantiate the counter
sync_counter uut (
    .clk(clk),
    .reset(reset),
    .count(count)
);

// Clock generation (10 ns period)
always #5 clk = ~clk;

initial
begin
    clk = 0;
    reset = 1;

    // Hold reset for 10 ns
    #10;
    reset = 0;

    // Run simulation for 160 ns
    #160;

    $finish;
end

// Monitor output
initial
begin
    $monitor("Time = %0t | Reset = %b | Count = %d (%b)",
              $time, reset, count, count);
end

endmodule